{
  "name": "sqlite-manager",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:core": "go run ./core/cmd/sqliteman-core -listen 127.0.0.1:17832",
    "dev": "pnpm dev:core & pnpm dev:web",
    "build:web": "pnpm --dir apps/web build",
    "build:core": "go build -o bin/sqliteman-core$([ \"$OS\" = Windows_NT ] && echo .exe) ./core/cmd/sqliteman-core",
    "build:mcp": "go build -o bin/sqliteman-mcp$([ \"$OS\" = Windows_NT ] && echo .exe) ./mcp/cmd/sqliteman-mcp",
    "test:core": "cd core && go test ./...",
    "desktop:dev": "pnpm --dir apps/desktop tauri dev",
    "desktop:build": "pnpm --dir apps/desktop tauri build"
  }
}
