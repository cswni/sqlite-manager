{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQLite Manager",
  "version": "0.1.0",
  "identifier": "dev.sqliteman.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "SQLite Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/sqliteman-core"
    ]
  },
  "plugins": {}
}
